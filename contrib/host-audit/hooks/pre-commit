#!/usr/bin/env bash
# security-checker-hook: pre-commit
# コミット前にステージ済みの変更をシークレット検査する。
# 導入: contrib/host-audit/install_hooks.sh   /   一時的に外す: git commit --no-verify
set -uo pipefail

if command -v gitleaks >/dev/null 2>&1; then
  # gitleaks 8.19+ は `git --staged`。`protect` は非推奨の別名で --help からも消えている
  if gitleaks git --help >/dev/null 2>&1; then
    sub=(git --staged)
  else
    sub=(protect --staged)
  fi
  # 検出は専用の終了コード (99) で返させ、gitleaks 自体のエラー (設定の誤り・git の失敗) と分ける
  err=$(gitleaks "${sub[@]}" --exit-code 99 2>&1 >/dev/null)
  rc=$?
  if [[ $rc -eq 99 ]]; then
    echo "❌ コミットにシークレットが含まれている可能性があります (gitleaks)"
    echo "   詳細: gitleaks ${sub[*]} --verbose"
    echo "   誤検知なら: git commit --no-verify"
    exit 1
  elif [[ $rc -ne 0 ]]; then
    echo "❌ gitleaks の実行に失敗しました (終了コード ${rc})。シークレット検査は行われていません"
    printf '%s\n' "$err" | tail -n 5 | sed 's/^/   /'
    echo "   gitleaks を直すか、承知のうえで: git commit --no-verify"
    exit 1
  fi
else
  # gitleaks が無い場合の簡易パターン検査. 検査の範囲が狭いことを知らせる
  echo "⚠️ gitleaks が見つからないため、既知の形式だけの簡易検査を行います (brew install gitleaks を推奨)" >&2
  patterns='AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}'
  patterns+='|glpat-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9_-]{20,}|[sr]k_live_[A-Za-z0-9]{16,}'
  patterns+='|AIza[0-9A-Za-z_-]{35}|xox[abeprs]-[0-9A-Za-z-]{10,}|npm_[A-Za-z0-9]{36}'
  patterns+='|-----BEGIN .*PRIVATE KEY'
  if git diff --cached -U0 | grep -E '^\+' | grep -qE "$patterns"; then
    echo "❌ コミットにシークレットらしき文字列が含まれています"
    echo "   誤検知なら: git commit --no-verify"
    exit 1
  fi
fi
exit 0
